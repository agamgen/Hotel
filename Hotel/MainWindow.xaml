<Window x:Class="Hotel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel"
        mc:Ignorable="d"
        Title="MainWindow" Height="560" Width="800">

    <Grid>
        <Image Source="/images/hotel.jpg" Stretch="UniformToFill"/>

        <Border Background="White" 
                Opacity="0.95"
                CornerRadius="10"
                Width="680" Height="480"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Padding="15">

            <Grid FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Text="להזמנת חופשה" Grid.Row="0" FontWeight="Bold" HorizontalAlignment="Right" FontSize="22" Margin="0,0,0,10"/>


                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Name="countries" Grid.Column="0" Height="40" FontSize="16" VerticalContentAlignment="Center" FontWeight="SemiBold">
                        <ComboBoxItem Content="בחר/י מדינה" IsSelected="True" IsEnabled="False"/>
                        <ComboBoxItem Content="ישראל" />
                        <ComboBoxItem Content="איטליה" />
                        <ComboBoxItem Content="ספרד" />
                    </ComboBox>

                    <ComboBox Name="citiesIsrael" Grid.Column="2" Height="40" FontSize="16" VerticalContentAlignment="Center" FontWeight="SemiBold">
                        <ComboBoxItem Content="בחר/י עיר" IsSelected="True" IsEnabled="False"/>
                        <ComboBoxItem Content="ירושלים" />
                        <ComboBoxItem Content="תל אביב" />
                        <ComboBoxItem Content="אילת" />
                    </ComboBox>
                </Grid>


                <ComboBox x:Name="hotelsisraeleilat" Grid.Row="2" Height="40" FontSize="16" VerticalContentAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" SelectionChanged="hotelsisraeleilat_SelectionChanged">
                    <ComboBoxItem Content="בחר/י מלון" IsSelected="True" IsEnabled="False"/>
                    <ComboBoxItem Content="קלאב הוטל"/>
                    <ComboBoxItem Content="מלכת שבא"/>
                    <ComboBoxItem Content="דן"/>
                </ComboBox>


                <Grid Grid.Row="3" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Button x:Name="ChooseCheckIn" Height="50" Click="ChooseCheckIn_Click">
                            <TextBlock x:Name="txtCheckIn" Text="בחר/י תאריך הגעה" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="popCheckIn" PlacementTarget="{Binding ElementName=ChooseCheckIn}" StaysOpen="False" Placement="Bottom">
                            <Calendar x:Name="calCheckIn" SelectionMode="SingleDate" SelectedDatesChanged="calCheckIn_SelectedDatesChanged"/>
                        </Popup>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Button x:Name="ChooseCheckOut" Height="50" Click="ChooseCheckOut_Click">
                            <TextBlock x:Name="txtCheckOut" Text="בחר/י תאריך עזיבה" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="popCheckOut" PlacementTarget="{Binding ElementName=ChooseCheckOut}" StaysOpen="False" Placement="Bottom">
                            <Calendar x:Name="calCheckOut" SelectionMode="SingleDate" SelectedDatesChanged="calCheckOut_SelectedDatesChanged"/>
                        </Popup>
                    </StackPanel>
                </Grid>


                <StackPanel Grid.Row="4" Margin="0,0,0,15">
                    <TextBlock Text="סוג חדר:" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <RadioButton x:Name="rbSingle" Content="יחיד" GroupName="RoomType" FontSize="14" Checked="RoomType_Checked"/>
                        <RadioButton x:Name="rbDouble" Content="זוגי" GroupName="RoomType" FontSize="14" IsChecked="True" Checked="RoomType_Checked"/>
                        <RadioButton x:Name="rbTriple" Content="זוג+ילד" GroupName="RoomType" FontSize="14" Checked="RoomType_Checked"/>
                        <RadioButton x:Name="rbQuad" Content="משפחתי" GroupName="RoomType" FontSize="14" Checked="RoomType_Checked"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                    <TextBlock x:Name="txtPerks" Text="פינוקים: " FontSize="13" Foreground="#1565C0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border Background="LemonChiffon" CornerRadius="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtNightsDisplay" Grid.Column="0" Text="סה&quot;כ לילות: 0" FontSize="15" FontWeight="Bold" Foreground="Black"/>
                            <TextBlock x:Name="txtTotalPrice" Grid.Column="1" Text="סה&quot;כ לתשלום: ₪0" FontSize="16" FontWeight="Bold" Foreground="DarkOliveGreen" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>